{
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "none",
  "bracketSpacing": true,
  "arrowParens": "always",
  "insertFinalNewline": true,
  "sortImports": {
    "order": "asc",
    "ignoreCase": true,
    "newlinesBetween": true,
    "internalPattern": ["$/", "@/", "#/"],
    "groups": [
      "builtin",
      "external",
      ["internal", "subpath"],
      ["parent", "sibling", "index"],
      "style",
      "side_effect",
      "type",
      "unknown"
    ],
    "customGroups": [
      { "groupName": "server", "elementNamePattern": ["$/**"] },
      { "groupName": "shared", "elementNamePattern": ["@/**"] },
      { "groupName": "app", "elementNamePattern": ["#/**"] }
    ]
  }
}
