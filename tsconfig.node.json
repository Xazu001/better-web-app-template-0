{
  "extends": "./tsconfig.json",
  "include": [
    "vite-env.d.ts",
    "vite.config.ts",
    "vite-preflight.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "react-router.config.ts",
    "worker.ts",
    "server/**/*",
    "shared/**/*",
    "scripts/**/*.ts",
    "test/unit/vite-config.test.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "types": ["node", "vite/client", "./worker-configuration.d.ts"],
    "lib": ["ES2022"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "paths": {
      "#/*": ["./app/*"],
      "$/*": ["./server/*"],
      "@/*": ["./shared/*"]
    }
  }
}
