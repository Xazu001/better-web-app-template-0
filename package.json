{
  "name": "better-web-app-template",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env APP_ENV=local CLOUDFLARE_ENV=dev react-router dev",
    "dev:local": "cross-env APP_ENV=local CLOUDFLARE_ENV=local react-router dev",
    "dev:clean": "node -e \"require('fs').rmSync('.vite',{recursive:true,force:true});require('fs').rmSync('node_modules/.vite',{recursive:true,force:true})\" && npm run dev:local",
    "dev:prod": "cross-env APP_ENV=local CLOUDFLARE_ENV=prod react-router dev",
    "build": "cross-env APP_ENV=dev CLOUDFLARE_ENV=dev react-router build",
    "build:prod": "cross-env APP_ENV=prod CLOUDFLARE_ENV=prod react-router build",
    "typegen": "wrangler types && react-router typegen",
    "typecheck": "wrangler types && react-router typegen && tsc -b",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:generate:prod": "drizzle-kit generate --config=drizzle.config.prod.ts",
    "db": "wrangler d1 migrations apply template-db-dev --remote --env dev",
    "db:local": "wrangler d1 migrations apply template-db-dev --local --env local",
    "db:prod": "wrangler d1 migrations apply template-db --remote --env prod",
    "db:full": "npm run db:generate && npm run db",
    "db:full:local": "npm run db:generate && npm run db:local",
    "db:full:prod": "npm run db:generate:prod && npm run db:prod",
    "db:migrate": "npm run db",
    "db:migrate:local": "npm run db:local",
    "db:migrate:prod": "npm run db:prod",
    "db:studio": "drizzle-kit studio --config=drizzle.config.dev.ts",
    "db:studio:prod": "drizzle-kit studio --config=drizzle.config.prod.ts",
    "deploy": "npm run build && wrangler deploy --config .build/server/wrangler.json",
    "deploy:prod": "npm run build:prod && wrangler deploy --config .build/server/wrangler.json",
    "cron:test": "curl http://localhost:5173/api/_dev/cron?all=true",
    "check:docs": "tsx scripts/check-docs.ts",
    "gen:keys": "tsx scripts/gen-keys.ts",
    "env:init": "tsx scripts/env-init.ts",
    "env:examples": "tsx scripts/env-init.ts --examples",
    "bootstrap": "tsx scripts/setup.ts",
    "check:setup": "tsx scripts/doctor.ts",
    "fmt": "oxfmt . \"!**/*.css\"",
    "fmt:style": "tsx node_modules/stylelint/bin/stylelint.mjs \"**/*.css\" --fix --config ./stylelint.config.js && tsx scripts/tw-order.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix --fix-suggestions && oxfmt --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "predev": "npx react-router typegen",
    "postinstall": "wrangler types",
    "cf:setup": "tsx scripts/provision.ts",
    "cf:setup:prod": "npm run cf:setup -- --env prod"
  },
  "dependencies": {
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.8",
    "isbot": "^5.2.2",
    "jose": "^6.2.12",
    "kysely": "^0.29.6",
    "kysely-d1": "^0.4.0",
    "lucide-react": "^1.47.0",
    "marked": "^16.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "react-toastify": "^11.1.0",
    "sanitize-html": "^2.18.0",
    "simple-icons": "^16.33.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@cloudflare/vite-plugin": "^1.56.0",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@playwright/test": "^1.63.0",
    "@react-router/dev": "^8.4.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@stylistic/stylelint-plugin": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/ui": "^5.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "cross-env": "^10.1.0",
    "cssnano": "^9.0.5",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^30.1.0",
    "jsonc-parser": "^3.3.1",
    "lightningcss": "^1.33.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "postcss": "8.5.28",
    "postcss-custom-media": "^12.0.1",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-block-no-ignored-properties": "^3.0.0",
    "stylelint-order": "^8.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.135.0"
  },
  "packageManager": "pnpm@12.5.1",
  "pnpm": {
    "ignoredBuiltDependencies": []
  }
}
