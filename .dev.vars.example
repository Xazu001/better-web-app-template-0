# ──────────────────────────────────────────────────────────────
# Local Worker secrets — copy to `.dev.vars` and fill in.
# `.dev.vars` is loaded by Wrangler for local dev and is gitignored.
# For deployed envs use `wrangler secret put <NAME>` instead.
# ──────────────────────────────────────────────────────────────

# RS256 key pair for JWT sessions (base64-encoded PEM).
# Generate with `pnpm gen:keys` (writes straight into `.dev.vars`), or manually:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt-private.pem
#   openssl pkey -in jwt-private.pem -pubout -out jwt-public.pem
#   base64 -i jwt-private.pem | tr -d '\n'   → JWT_PRIVATE_KEY
#   base64 -i jwt-public.pem | tr -d '\n'    → JWT_PUBLIC_KEY
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# X-API-Key for private /api/priv endpoints
# (required — `secrets.required` in wrangler.jsonc fails the deploy without it)
PRIV_API_KEY=
