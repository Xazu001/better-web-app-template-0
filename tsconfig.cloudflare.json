{
  "extends": "./tsconfig.json",
  "include": [
    ".react-router/types/**/*",
    "app/**/*",
    "app/**/.server/**/*",
    "app/**/.client/**/*",
    "server/**/*",
    "shared/**/*",
    "scripts/lib/**/*",
    "scripts/env-init.ts",
    "scripts/gen-keys.ts",
    "scripts/provision.ts",
    "test/**/*",
    "worker-configuration.d.ts",
    "worker.ts",
    "vite-env.d.ts",
    "vite-preflight.ts"
  ],
  "exclude": ["test/unit/vite-config.test.ts"],
  "compilerOptions": {
    "composite": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "rootDirs": [".", "./.react-router/types"],
    "paths": {
      "#/*": ["./app/*"],
      "$/*": ["./server/*"],
      "@/*": ["./shared/*"]
    },
    "esModuleInterop": true,
    "resolveJsonModule": true
  }
}
