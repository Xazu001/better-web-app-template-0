# ──────────────────────────────────────────────────────────────
# Local development environment (tsx scripts + drizzle-kit)
# Copy to `.env` and fill in your own values — never commit `.env`.
# ──────────────────────────────────────────────────────────────

# Cloudflare account + API token (used by drizzle.config.*.ts d1-http)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# D1 database IDs (from `wrangler d1 create` / `wrangler d1 list`)
CLOUDFLARE_DB_ID=
CLOUDFLARE_DB_PROD_ID=

# ──────────────────────────────────────────────────────────────
# Worker secrets (set with `wrangler secret put`, not .env):
#   JWT_PRIVATE_KEY   — PKCS8 RSA private key (base64), signs JWT sessions
#   JWT_PUBLIC_KEY    — SPKI RSA public key (base64), verifies JWT sessions
#   PRIV_API_KEY      — X-API-Key for the private /api/priv endpoints
#
# Generate a local JWT pair with `pnpm gen:keys`; copy `.dev.vars` to `.dev.vars.prod`,
# then generate its distinct pair with `pnpm gen:keys .dev.vars.prod`.
# ──────────────────────────────────────────────────────────────
